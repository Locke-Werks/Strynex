# ---------- Protobuf ----------
# Generated language bindings. The .proto files under schemas/proto are the
# source of truth; generated code is a build artifact and is not committed.
schemas/gen/
*_pb2.py
*_pb2.pyi
*_pb2_grpc.py
*.pb.go
*.pb.cc
*.pb.h
*_pb.js
*_pb.d.ts
*.descriptor
*.desc
descriptor_set.pb

# Buf
buf.lock

# ---------- Test artifacts ----------
# Large recorded captures are distributed out-of-band, not committed, unless a
# specific corpus file is deliberately added with `git add -f`.
tests/corpora/pcap/*.pcap
tests/corpora/pcap/*.pcapng
tests/reports/
*.log

